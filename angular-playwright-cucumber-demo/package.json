{
  "name": "angular-playwright-cucumber-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test:bdd": "TS_NODE_PROJECT=e2e/tsconfig.json cucumber-js",
    "test:bdd:headed": "HEADLESS=false TS_NODE_PROJECT=e2e/tsconfig.json cucumber-js",
    "test:bdd:headless": "HEADLESS=true TS_NODE_PROJECT=e2e/tsconfig.json cucumber-js",
    "pretest:bdd": "npx playwright install chromium",
    "report": "node e2e/generate-report.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.3",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@cucumber/cucumber": "^11.0.0",
    "@playwright/test": "^1.49.0",
    "cucumber-html-reporter": "^7.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
