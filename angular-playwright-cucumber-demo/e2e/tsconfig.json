{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./dist",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts"
  ]
}
